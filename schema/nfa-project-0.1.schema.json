{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://register.nfa.ch/schema/nfa-project-0.1.schema.json",
  "title": "NFA project file",
  "description": "One file per project (nfa-project.json), kept in the project's own repository. The NFA Project Register collects these files and displays them.",
  "type": "object",
  "required": ["schemaVersion", "id", "slug", "name", "stage", "summary", "location", "organisations", "measurements", "datasets", "agreements", "contact", "dates"],
  "$defs": {
    "disclosure": {
      "description": "public = shown in full; on-request = entry shown, content on request via the contact address; not-disclosed = entry shown with a reason only.",
      "enum": ["public", "on-request", "not-disclosed"]
    },
    "status": { "enum": ["planned", "pending", "in-progress", "available", "draft", "signed", "ended"] },
    "orgRefs": { "type": "array", "items": { "type": "string" } },
    "period": { "type": "string", "description": "Id of a measurement round in 'schedule' (t0, t1 ...)" }
  },
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^NFA-[0-9]{3,}$",
      "description": "Register ID: NFA- plus a running number across all projects (NFA-001, NFA-002 ...). Never reused, never changed."
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "tagline": { "type": "string" },
    "stage": { "enum": ["scoping", "design", "baseline", "monitoring", "verified", "closed"] },
    "stageNote": { "type": "string" },
    "summary": { "type": "string", "maxLength": 400 },
    "description": { "type": "array", "items": { "type": "string" } },
    "location": {
      "type": "object",
      "required": ["countries", "cantons", "point"],
      "properties": {
        "countries": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" }, "minItems": 1, "description": "ISO 3166-1 alpha-2" },
        "cantons": { "type": "array", "items": { "type": "string" }, "description": "Swiss canton codes (AG, GR ...); empty outside Switzerland" },
        "municipality": { "type": "string" },
        "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[longitude, latitude], WGS84" },
        "pointPrecision": { "enum": ["exact", "site", "municipality", "region"] },
        "boundary": { "type": ["string", "null"], "description": "Relative path to a GeoJSON file in the project repository" },
        "boundaryStatus": { "enum": ["surveyed", "indicative", "pending"] },
        "boundaryNote": { "type": "string" },
        "areaHa": { "type": ["number", "null"] },
        "areaPrecision": { "enum": ["surveyed", "approximate"] },
        "referenceAreas": {
          "type": ["string", "null"],
          "description": "Relative path to a GeoJSON file with the reference areas: points or outlines, features may carry a 'name'. Shown in orange on the project map."
        },
        "referenceAreasStatus": { "enum": ["surveyed", "indicative", "pending"] },
        "referenceAreasNote": { "type": "string" },
        "sites": {
          "type": "array",
          "description": "Sites of the project, each shown as a dot on the project map. Use it when a project has more than one site.",
          "items": {
            "type": "object",
            "required": ["name", "point"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "municipality": { "type": "string" },
              "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "[longitude, latitude], WGS84" },
              "pointPrecision": { "type": "string" },
              "areaHa": { "type": "number" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "ecosystem": { "type": "array", "items": { "type": "string" } },
    "landUse": { "type": "string" },
    "developers": { "$ref": "#/$defs/orgRefs", "description": "Project developer(s): organisation ids. Shown at the top of the project page. Named only once they agree." },
    "developersNote": { "type": "string", "description": "Shown while no developer is named, e.g. 'Name follows'" },
    "funding": {
      "type": "object",
      "description": "Who funds the project. Shown at the top of the project page. Funders are named only once they agree; the amount carries its own disclosure level.",
      "properties": {
        "funders": { "$ref": "#/$defs/orgRefs" },
        "fundersNote": { "type": "string", "description": "Shown while no funder is named" },
        "amount": {
          "type": "object",
          "required": ["disclosure"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "currency": { "type": "string" },
            "period": { "type": "string", "description": "What the amount covers, e.g. '2026 to 2028'" },
            "disclosure": { "$ref": "#/$defs/disclosure" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "method": { "type": "object" },
    "dates": {
      "type": "object",
      "required": ["registered", "lastUpdated"],
      "properties": {
        "registered": { "type": "string", "format": "date" },
        "lastUpdated": { "type": "string", "format": "date" },
        "durationNote": { "type": "string", "description": "Planned duration in a few words, e.g. 'Project planned for at least 15 years'. Shown small under the basket." }
      }
    },
    "schedule": {
      "description": "Measurement rounds, in order. The first is the baseline. The basket at the top of the project page uses these as its time axis.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "years", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/period" },
          "label": { "type": "string" },
          "years": { "type": "string", "description": "Year or years of the round, e.g. '2028' or '2026–2027'" },
          "status": { "enum": ["planned", "in-progress", "done"] },
          "note": { "type": "string" }
        }
      }
    },
    "outcome": {
      "description": "The headline indicator: is biodiversity improving? Set by NFA from the basket, never computed by the page. Stays 'not-yet-measurable' until a round after the baseline is complete.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not-yet-measurable", "improving", "stable", "declining"] },
        "value": { "type": ["number", "null"], "description": "Change across the basket against the baseline, in 'unit'" },
        "unit": { "type": "string" },
        "from": { "anyOf": [{ "$ref": "#/$defs/period" }, { "type": "null" }] },
        "to": { "anyOf": [{ "$ref": "#/$defs/period" }, { "type": "null" }] },
        "verified": { "type": "boolean", "description": "true once the reading has passed independent review" },
        "method": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "images": {
      "description": "Photos of the project. The first is the header photo; with two or more, an Images section is shown.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "alt"],
        "properties": {
          "src": { "type": "string" },
          "alt": { "type": "string" },
          "caption": { "type": "string" },
          "date": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
          "credit": { "type": "string" },
          "licence": { "type": "string" }
        }
      }
    },
    "monitoring": {
      "description": "Optional monitoring streams: key figures, small charts, sounds, as read from the provider's dashboard. Shown in the full record. Live items that belong to no basket metric also appear in the summary under 'Did you know?'.",
      "type": "object",
      "required": ["provider", "period", "kpis"],
      "properties": {
        "title": { "type": "string" },
        "provider": { "type": "string" },
        "method": { "type": "string" },
        "period": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" } } },
        "retrieved": { "type": "string" },
        "dashboardUrl": { "type": "string" },
        "note": { "type": "string" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "provider", "status"],
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "label": { "type": "string" },
              "status": { "enum": ["live", "example"], "description": "example = placeholder figures, shown with an Example data tag" },
              "period": { "type": "string" }
            }
          }
        },
        "exampleNote": { "type": "string" },
        "kpis": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" },
              "note": { "type": "string" },
              "source": { "type": "string" },
              "metric": { "type": "string", "description": "Measurement id, if the item belongs to a basket metric. Items without it count as nice to know." }
            }
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "labels", "values"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["bars", "hbars", "split"] },
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "values": { "type": "array", "items": { "type": "number" } },
              "unit": { "type": "string" },
              "note": { "type": "string" },
              "source": { "type": "string" },
              "decimals": { "type": "integer" },
              "metric": { "type": "string", "description": "Measurement id, if the item belongs to a basket metric. Items without it count as nice to know." }
            }
          }
        },
        "sounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["species"],
            "properties": {
              "species": { "type": "string" },
              "latin": { "type": "string" },
              "redList": { "type": "string" },
              "lastHeard": { "type": "string" },
              "detections": { "type": "number" },
              "recorders": { "type": "string" },
              "clipRecorded": { "type": "string" },
              "clipRecorder": { "type": "string" },
              "dataset": { "type": "string", "description": "Dataset id: the clip is also listed as a sample there" },
              "src": { "type": ["string", "null"], "description": "Short clip in the project repository, e.g. audio/kingfisher.mp3; null = clip follows" },
              "credit": { "type": "string" },
              "image": { "type": ["string", "null"], "description": "Small photo of the species, relative path, e.g. images/species/redwing.jpg" },
              "imageCredit": { "type": "string", "description": "Photographer" },
              "imageLicence": { "type": "string", "description": "Licence of the photo, e.g. CC BY-SA 4.0" },
              "imageSource": { "type": "string", "description": "Page the photo comes from" }
            }
          }
        },
        "didYouKnow": { "type": "string", "description": "One line introducing the 'Did you know?' section of the summary" },
        "place": { "type": "string", "description": "Where the recorders stand, for the heading of the sound list" },
        "summarySounds": { "type": "integer", "minimum": 1, "description": "How many recordings the sound list shows before the 'Show all' button, most threatened first. Default 3." }
      }
    },
    "organisations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "type": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "ror": { "type": ["string", "null"] },
          "logo": { "type": ["string", "null"] },
          "logoConfirmed": { "type": "boolean", "description": "Logo shown only when true (written confirmation received)" },
          "logoConfirmedOn": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Date of the written confirmation. The confirmation itself is kept internally, not in the repository."
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "consent"],
        "properties": {
          "name": { "type": "string" },
          "organisation": { "type": "string" },
          "role": { "type": "string" },
          "orcid": { "type": ["string", "null"] },
          "consent": { "type": "boolean", "description": "Name shown only when true" }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "metric", "group", "status"],
        "properties": {
          "group": { "enum": ["core", "context", "design"] },
          "provider": { "$ref": "#/$defs/orgRefs" },
          "status": { "$ref": "#/$defs/status" },
          "datasets": { "type": "array", "items": { "type": "string" } },
          "plainName": { "type": "string", "description": "Short everyday name for the summary view" },
          "tells": { "type": "string", "description": "One line in plain language: what this metric shows" },
          "indicator": { "type": "string", "description": "What the series value stands for, e.g. 'Species richness plus abundance'" },
          "unit": { "type": "string" },
          "higherIsBetter": { "type": "boolean", "description": "Default true. Set false where a falling value is the improvement." },
          "series": {
            "description": "One entry per measurement round. Values stay null until measured; nothing is estimated.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["period"],
              "properties": {
                "period": { "$ref": "#/$defs/period" },
                "value": { "type": ["number", "null"], "description": "Project area" },
                "reference": { "type": ["number", "null"], "description": "Reference areas" },
                "status": { "enum": ["planned", "in-progress", "available"] },
                "note": { "type": "string" }
              }
            }
          }
        }
      },
      "description": "All measurements. Those in group 'core' form the basket shown at the top of the project page."
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "disclosure", "status"],
        "properties": {
          "provider": { "$ref": "#/$defs/orgRefs" },
          "doi": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "licence": { "type": ["string", "null"] },
          "disclosure": { "$ref": "#/$defs/disclosure" },
          "reason": { "type": "string" },
          "status": { "$ref": "#/$defs/status" }
        }
      }
    },
    "agreements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "parties", "status", "disclosure"],
        "properties": {
          "parties": { "$ref": "#/$defs/orgRefs" },
          "status": { "$ref": "#/$defs/status" },
          "fees": { "type": ["string", "null"] },
          "disclosure": { "$ref": "#/$defs/disclosure" },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "documents": { "type": "array", "items": { "type": "object", "required": ["title", "disclosure"], "properties": { "disclosure": { "$ref": "#/$defs/disclosure" } } } },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "event", "status"],
        "properties": {
          "status": { "enum": ["done", "ongoing", "planned"] },
          "type": {
            "enum": ["intervention", "measurement", "data", "review", "record"],
            "description": "intervention = work on the ground (shown in the summary view); the others are measurement, data, review plus record steps (full record)"
          },
          "by": { "$ref": "#/$defs/orgRefs" },
          "date": { "type": "string", "description": "YYYY, YYYY-MM, YYYY-MM-DD or YYYY-Qn" }
        }
      }
    },
    "contact": { "type": "string", "format": "email" },
    "licence": { "type": "string" },
    "changelog": { "type": "array", "items": { "type": "object", "required": ["date", "change"] } }
  }
}
